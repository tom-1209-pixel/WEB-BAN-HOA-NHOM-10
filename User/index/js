    input.value = ""; // Tự dọn sạch thanh gõ
};

// 2. Bấm vào Tab "Tất cả sản phẩm" (hoặc tab nào cũng được) sẽ tự động xóa từ khóa
document.querySelectorAll('.cat-item').forEach(li => {
  li.addEventListener('click', function() {
    searchQuery = ''; // Xóa sạch từ khóa đang bị kẹt
    processFilters(); // Cập nhật lại toàn bộ hoa ra màn hình
  });
});
