/* ======================
   PARTICLE BACKGROUND
====================== */

let scene,camera,renderer,particles;
let currentColor=new THREE.Color(0xff9ecb);

init();

function init(){

scene=new THREE.Scene();

camera=new THREE.PerspectiveCamera(
75,window.innerWidth/window.innerHeight,0.1,1000);
camera.position.z=5;

renderer=new THREE.WebGLRenderer({alpha:true,antialias:true});
renderer.setSize(window.innerWidth,window.innerHeight);

document.getElementById("canvas-container")
.appendChild(renderer.domElement);

createParticles();
animate();
}

function createParticles(){

const geo=new THREE.BufferGeometry();
const vertices=[];

for(let i=0;i<5000;i++){
vertices.push(
THREE.MathUtils.randFloatSpread(20),
THREE.MathUtils.randFloatSpread(20),
THREE.MathUtils.randFloatSpread(20)
);
}

geo.setAttribute("position",
new THREE.Float32BufferAttribute(vertices,3));

const mat=new THREE.PointsMaterial({
color:currentColor,
size:0.06,
transparent:true,
opacity:.85
});

particles=new THREE.Points(geo,mat);
scene.add(particles);
}

function animate(){
requestAnimationFrame(animate);
particles.rotation.y+=0.0015;
particles.rotation.x+=0.0007;
renderer.render(scene,camera);
}

window.addEventListener("resize",()=>{
camera.aspect=window.innerWidth/window.innerHeight;
camera.updateProjectionMatrix();
renderer.setSize(window.innerWidth,window.innerHeight);
});

/* ======================
   FLOWER 3D VIEWER
====================== */

let viewerScene,viewerCamera,viewerRenderer,flower;
const viewer=document.getElementById("viewer3d");
const canvas=document.getElementById("viewer3d-canvas");

document.querySelectorAll(".btn-3d").forEach(btn=>{
btn.onclick=openViewer;
});

function openViewer(){
viewer.classList.remove("hidden");
if(!viewerRenderer)initViewer();
}

viewer.onclick=()=>viewer.classList.add("hidden");

function initViewer(){

viewerScene=new THREE.Scene();

viewerCamera=new THREE.PerspectiveCamera(
60,canvas.clientWidth/canvas.clientHeight,0.1,1000);
viewerCamera.position.z=4;

viewerRenderer=new THREE.WebGLRenderer({alpha:true,antialias:true});
viewerRenderer.setSize(canvas.clientWidth,canvas.clientHeight);
canvas.appendChild(viewerRenderer.domElement);

viewerScene.add(new THREE.AmbientLight(0xffc0cb,.7));

const light=new THREE.PointLight(0xffffff,1.5);
light.position.set(5,5,5);
viewerScene.add(light);

createFlower();
animateViewer();
}

function createFlower(){

const group=new THREE.Group();

for(let i=0;i<12;i++){
const geo=new THREE.SphereGeometry(.5,32,32);
const mat=new THREE.MeshStandardMaterial({color:0xff69b4});
const petal=new THREE.Mesh(geo,mat);

const a=i/12*Math.PI*2;
petal.position.set(Math.cos(a),Math.sin(a),0);
petal.scale.set(.6,1,.3);
group.add(petal);
}

const center=new THREE.Mesh(
new THREE.SphereGeometry(.4,32,32),
new THREE.MeshStandardMaterial({color:0xffd700})
);

group.add(center);
flower=group;
viewerScene.add(flower);
}

function animateViewer(){
requestAnimationFrame(animateViewer);
if(flower) flower.rotation.y+=0.01;
viewerRenderer.render(viewerScene,viewerCamera);
}
