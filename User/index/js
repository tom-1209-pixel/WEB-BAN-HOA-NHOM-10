/* =========================
   SMOOTH SCROLL (CINEMATIC)
========================= */
document.documentElement.style.scrollBehavior = "smooth";


/* =========================
   THREE BACKGROUND
========================= */

let scene, camera, renderer, particles;
let mouse = { x: 0, y: 0 };
let particlePositions;

init();

function init() {

    scene = new THREE.Scene();

    camera = new THREE.PerspectiveCamera(
        75,
        window.innerWidth / window.innerHeight,
        0.1,
        1000
    );
    camera.position.z = 5;

    renderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: true
    });

    renderer.setSize(window.innerWidth, window.innerHeight);

    document
        .getElementById("canvas-container")
        .appendChild(renderer.domElement);

    createParticles();
    animate();
}

function createParticles() {

    const geo = new THREE.BufferGeometry();
    const vertices = [];

    for (let i = 0; i < 5000; i++) {
        vertices.push(
            THREE.MathUtils.randFloatSpread(20),
            THREE.MathUtils.randFloatSpread(20),
            THREE.MathUtils.randFloatSpread(20)
        );
    }

    particlePositions = new Float32Array(vertices);

    geo.setAttribute(
        "position",
        new THREE.BufferAttribute(particlePositions, 3)
    );

    const mat = new THREE.PointsMaterial({
        color: 0xff9ecb,
        size: 0.06,
        transparent: true,
        opacity: 0.85
    });

    particles = new THREE.Points(geo, mat);
    scene.add(particles);
}

/* ===== PARTICLE AVOID MOUSE ===== */

window.addEventListener("mousemove", e => {
    mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
});

function animate() {

    requestAnimationFrame(animate);

    const positions = particles.geometry.attributes.position.array;

    for (let i = 0; i < positions.length; i += 3) {

        const dx = positions[i] - mouse.x * 5;
        const dy = positions[i + 1] - mouse.y * 5;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < 2) {
            positions[i] += dx * 0.02;
            positions[i + 1] += dy * 0.02;
        }
    }

    particles.geometry.attributes.position.needsUpdate = true;

    particles.rotation.y += 0.0015;
    particles.rotation.x += 0.0007;

    renderer.render(scene, camera);
}


/* =========================
   NAVBAR GLASS LIGHT EFFECT
========================= */

const navbar = document.querySelector(".navbar");

window.addEventListener("scroll", () => {
    navbar.classList.toggle("scrolled", window.scrollY > 50);
});

document.addEventListener("mousemove", e => {

    const x = e.clientX / window.innerWidth * 100;
    navbar.style.background =
        `linear-gradient(120deg,
        rgba(255,255,255,0.15) ${x}%,
        rgba(0,0,0,.55))`;
});


/* =========================
   APPLE STYLE CARD TILT
========================= */

document.querySelectorAll(".glass-card").forEach(card => {

    card.addEventListener("mousemove", e => {

        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const rotateY = (x / rect.width - 0.5) * 12;
        const rotateX = -(y / rect.height - 0.5) * 12;

        card.style.transform =
            `perspective(900px)
             rotateX(${rotateX}deg)
             rotateY(${rotateY}deg)
             scale(1.04)`;
    });

    card.addEventListener("mouseleave", () => {
        card.style.transform =
            "perspective(900px) rotateX(0) rotateY(0)";
    });

});


/* =========================
   3D FLOWER VIEWER
========================= */

let viewerScene, viewerCamera, viewerRenderer, flower;
const viewer = document.getElementById("viewer3d");
const canvas = document.getElementById("viewer3d-canvas");

document.addEventListener("click", e => {
    if (e.target.classList.contains("btn-3d")) openViewer();
});

function openViewer() {
    viewer.classList.remove("hidden");
    if (!viewerRenderer) initViewer();
}

viewer.onclick = () => viewer.classList.add("hidden");

function initViewer() {

    viewerScene = new THREE.Scene();

    viewerCamera = new THREE.PerspectiveCamera(
        60,
        canvas.clientWidth / canvas.clientHeight,
        0.1,
        1000
    );
    viewerCamera.position.z = 4;

    viewerRenderer = new THREE.WebGLRenderer({
        alpha: true,
        antialias: true
    });

    viewerRenderer.setSize(
        canvas.clientWidth,
        canvas.clientHeight
    );

    canvas.appendChild(viewerRenderer.domElement);

    viewerScene.add(new THREE.AmbientLight(0xffc0cb, .7));

    const light = new THREE.PointLight(0xffffff, 1.5);
    light.position.set(5, 5, 5);
    viewerScene.add(light);

    createFlower();
    animateViewer();
}

function createFlower() {

    const group = new THREE.Group();

    for (let i = 0; i < 12; i++) {

        const petal = new THREE.Mesh(
            new THREE.SphereGeometry(.5, 32, 32),
            new THREE.MeshStandardMaterial({ color: 0xff69b4 })
        );

        const a = i / 12 * Math.PI * 2;
        petal.position.set(Math.cos(a), Math.sin(a), 0);
        petal.scale.set(.6, 1, .3);

        group.add(petal);
    }

    group.add(
        new THREE.Mesh(
            new THREE.SphereGeometry(.4, 32, 32),
            new THREE.MeshStandardMaterial({ color: 0xffd700 })
        )
    );

    flower = group;
    viewerScene.add(flower);
}

function animateViewer() {
    requestAnimationFrame(animateViewer);
    if (flower) flower.rotation.y += 0.01;
    viewerRenderer.render(viewerScene, viewerCamera);
}
