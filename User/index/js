window.calculateOrderTotal = function() {
    let rawTotal = parseInt(document.getElementById('total-price')?.textContent.replace(/\D/g, '') || 0);
    let discount = 0;
    if(rawTotal >= 1000000) discount = 50000;

    let shippingFee = 0;
    const selectedMethod = document.querySelector('input[name="shipping_method"]:checked')?.value || 'standard';

    if (selectedMethod === 'express') {
        shippingFee = 50000; 
    }

    let finalTotal = rawTotal - discount + shippingFee;


    if(document.getElementById('summary-subtotal')) document.getElementById('summary-subtotal').textContent = formatVND(rawTotal);
    if(document.getElementById('summary-discount')) document.getElementById('summary-discount').textContent = `-${formatVND(discount)}`;
    
    const shipEl = document.getElementById('summary-shipping');
    if(shipEl) {
        shipEl.textContent = shippingFee > 0 ? formatVND(shippingFee) : 'Miễn phí';
        shipEl.style.color = shippingFee > 0 ? '#ffb6c1' : '#fff'; // Đổi màu cho nổi
    }
    
    if(document.getElementById('summary-total')) document.getElementById('summary-total').textContent = formatVND(finalTotal);
};

