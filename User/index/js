/* =========================================
   1. HERO PARALLAX TILT 
   ========================================= */
const heroContent = document.querySelector('.hero-content');

document.addEventListener('mousemove', (e) => {
  if (heroContent) {
    let x = (window.innerWidth / 2 - e.pageX) / 45;
    let y = (window.innerHeight / 2 - e.pageY) / 45;
    heroContent.style.transform = `rotateY(${x}deg) rotateX(${y}deg)`;
  }
});

/* =========================================
   2. NAVBAR SCROLL EFFECT
   ========================================= */
window.addEventListener('scroll', () => {
  const nav = document.querySelector('nav');
  if (window.scrollY > 80) {
    nav.classList.add('scrolled');
  } else {
    nav.classList.remove('scrolled');
  }
});

/* =========================================
   3. CARD 3D TILT HOVER (Đã fix xung đột Fade)
   ========================================= */
const cards = document.querySelectorAll('.card');

cards.forEach(card => {
  card.addEventListener('mouseenter', () => {
    // Tạm tắt độ trễ CSS để hiệu ứng 3D bám sát chuột tức thì
    card.style.transition = 'transform 0.1s ease-out, box-shadow 0.3s ease';
  });

  card.addEventListener('mousemove', (e) => {
    let rect = card.getBoundingClientRect();
    let x = e.clientX - rect.left;
    let y = e.clientY - rect.top;
    let centerX = rect.width / 2;
    let centerY = rect.height / 2;
    
    let rotateX = (centerY - y) / 15; 
    let rotateY = (x - centerX) / 15;
    
    card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
  });
  
  card.addEventListener('mouseleave', () => {
    // Trả giá trị rỗng để XÓA inline style, nhường quyền lại cho class .show
    card.style.transition = ''; 
    card.style.transform = ''; 
  });
});

/* =========================================
   4. FADE IN/OUT ON SCROLL (2 CHIỀU TỐI ƯU)
   ========================================= */
const faders = document.querySelectorAll('.fade-in');

const appearOptions = {
  threshold: 0.05, // Hạ mức nhạy xuống để các thẻ xuất hiện đều nhau
  rootMargin: "0px" 
};

const appearOnScroll = new IntersectionObserver(function(entries, observer) {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('show');
    } else {
      entry.target.classList.remove('show');
    }
  });
}, appearOptions);

faders.forEach(fader => {
  appearOnScroll.observe(fader);
});

