<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SGU Flower</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div id="canvas-container"></div>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">SGU FLOWER</a>
            <div class="d-flex border rounded-pill px-3 py-1 bg-dark">
                <small>Chào, Bạn | Giỏ hàng (0)</small>
            </div>
        </div>
    </nav>

    <main class="container">
        <section class="hero-section">
            <div>
                <h1 class="display-2 fw-bold">SGU Flower 3D</h1>
                <p class="lead">Trải nghiệm mua sắm hoa tươi trong không gian thực tế ảo.</p>
                <a href="#products" class="btn btn-outline-light btn-lg rounded-pill">Khám phá ngay</a>
            </div>
        </section>

        <section id="products" class="py-5">
            <div class="glass-card p-4 mb-5">
                <form class="row g-3">
                    <div class="col-md-5">
                        <input type="text" class="form-control bg-transparent text-white" placeholder="Tìm tên hoa...">
                    </div>
                    <div class="col-md-4">
                        <select class="form-select bg-transparent text-white">
                            <option class="text-dark">Tất cả loại hoa</option>
                            <option class="text-dark">Hoa Hồng</option>
                            <option class="text-dark">Hoa Lan</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100">Lọc sản phẩm</button>
                    </div>
                </form>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card glass-card h-100 text-white p-3">
                        <img src="https://via.placeholder.com/300x200" class="card-img-top rounded" alt="Hoa">
                        <div class="card-body">
                            <h5 class="card-title">Bó Hoa Ánh Trăng</h5>
                            <p class="price">500.000đ</p>
                            <div class="d-grid gap-2">
                                <button class="btn btn-sm btn-info">Xoay 3D</button>
                                <button class="btn btn-sm btn-light">Thêm vào giỏ</button>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
        </section>
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="script.js"></script>
</body>
</html>
