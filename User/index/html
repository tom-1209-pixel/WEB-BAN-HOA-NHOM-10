                <input type="radio" name="shipping_method" value="standard" checked onchange="togglePreorder()">
                <div class="card-content">
                  <div class="card-icon"><i class="ph-light ph-moped"></i></div>
                  <div class="card-details"><h4>Giao tiêu chuẩn (Trong ngày)</h4></div>
                </div>
              </label>
              <label class="radio-card">
                <input type="radio" name="shipping_method" value="express" onchange="togglePreorder()">
                <div class="card-content">
                  <div class="card-icon"><i class="ph-light ph-rocket-launch"></i></div>
                  <div class="card-details"><h4>Giao hỏa tốc (90-120p)</h4></div>
                </div>
              </label>
              <label class="radio-card">
                <input type="radio" name="shipping_method" value="preorder" onchange="togglePreorder()">
                <div class="card-content">
                  <div class="card-icon"><i class="ph-light ph-clock"></i></div>
                  <div class="card-details"><h4>Hẹn giờ nhận hoa</h4></div>
                </div>
              </label>
            </div>
            <div id="preorder-time-box" class="input-stack" style="display: none; margin-top: 15px;">
              <input type="datetime-local" id="chk-datetime" class="glass-input" style="color-scheme: dark;">
            </div>
          </div>

          <div class="checkout-step-modern">
            <h3 class="step-title"><span class="step-num">3</span> Phương thức thanh toán</h3>
            <div class="radio-card-group">
              <label class="radio-card">
                <input type="radio" name="payment_method" value="cash" checked>
                <div class="card-content">
                  <div class="card-icon"><i class="ph-light ph-money"></i></div>
                  <div class="card-details"><h4>Tiền mặt (COD)</h4></div>
                </div>
              </label>
              <label class="radio-card">
                <input type="radio" name="payment_method" value="online">
                <div class="card-content">
                  <div class="card-icon" style="color:#d82d8b;"><i class="ph-light ph-wallet"></i></div>
                  <div class="card-details"><h4 style="color:#d82d8b;">Ví MoMo</h4></div>
                </div>
              </label>
              <label class="radio-card">
                <input type="radio" name="payment_method" value="transfer">
                <div class="card-content">
                  <div class="card-icon" style="color:#3498db;"><i class="ph-light ph-bank"></i></div>
                  <div class="card-details"><h4 style="color:#3498db;">Chuyển khoản</h4></div>
                </div>
              </label>
            </div>
          </div>

        </div>

        <div class="checkout-summary-col">
          <div class="summary-card-modern">
            <h3>Tóm Tắt Đơn Hàng</h3>
            <div class="summary-line"><span>Tạm tính:</span><strong id="summary-subtotal">0đ</strong></div>
            <div class="summary-line"><span>Phí ship:</span><strong id="summary-shipping">Miễn phí</strong></div>
            <div class="summary-line highlight-line"><span>Giảm giá:</span><strong id="summary-discount">-0đ</strong></div>
            <div class="summary-divider"></div>
            <div class="summary-total-line"><span>Tổng cộng:</span><strong id="summary-total">0đ</strong></div>
            
            <button type="button" onclick="handleOrderSubmit(event)" class="submit-btn-modern">XÁC NHẬN ĐẶT HÀNG</button>
            <p class="secure-text"><i class="ph-light ph-shield-check"></i> Thông tin được bảo mật tuyệt đối</p>
          </div>
        </div>

      </form>
    </div>
  </div>
  <button id="back-to-top" class="back-to-top-btn" title="Lên đầu trang"><i class="ph-light ph-arrow-up"></i></button>

  <div class="floating-chat-container">
    <a href="https://zalo.me/0976xxxxxx" target="_blank" class="chat-widget zalo-widget" title="Chat Zalo"><i class="ph-light ph-chat-teardrop-dots"></i></a>
    <a href="https://m.me/sguflower" target="_blank" class="chat-widget mess-widget" title="Chat Messenger"><i class="ph-light ph-messenger-logo"></i></a>
  </div>
  
