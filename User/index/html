<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SGU Flower</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- FONT -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<link rel="stylesheet" href="style.css">
</head>

<body>

<div id="canvas-container"></div>

<!-- NAVBAR -->
<nav class="navbar navbar-dark fixed-top">
<div class="container">
<a href="#" class="navbar-brand fw-bold">SGU FLOWER</a>

<div class="d-flex border rounded-pill px-3 py-1 bg-dark">
<small id="cart-text">Chào, Bạn | Giỏ hàng (0)</small>
</div>
</div>
</nav>

<main class="container">

<!-- HERO -->
<section class="hero-section">
<div>
<h1>SGU Flower 3D</h1>
<p class="lead">Trải nghiệm mua sắm hoa tươi trong không gian nghệ thuật</p>
<a href="#products" class="btn btn-primary rounded-pill">
Khám phá ngay
</a>
</div>
</section>

<!-- PRODUCTS -->
<section id="products" class="py-5">

<div class="glass-card p-4 mb-5">
<form class="row g-3" onsubmit="return false;">
<div class="col-md-5">
<input class="form-control bg-transparent text-white"
placeholder="Tìm tên hoa...">
</div>

<div class="col-md-4">
<select class="form-select bg-transparent text-white">
<option class="text-dark">Tất cả loại hoa</option>
<option class="text-dark">Hoa Hồng</option>
<option class="text-dark">Hoa Lan</option>
</select>
</div>

<div class="col-md-3">
<button class="btn btn-primary w-100">Lọc sản phẩm</button>
</div>
</form>
</div>

<div class="row g-4">

<!-- 12 PRODUCT CARDS -->
<script>
for(let i=1;i<=12;i++){
document.write(`
<div class="col-md-4">
<div class="card glass-card product-card h-100 text-white p-3">

<img src="https://via.placeholder.com/300x200"
class="card-img-top rounded">

<div class="card-body">
<h5>Bó Hoa Nghệ Thuật ${i}</h5>
<p class="price">${400+i*20}.000đ</p>

<div class="d-grid gap-2">
<button class="btn btn-info btn-3d">Xoay 3D</button>
<button class="btn btn-light add-cart">Thêm vào giỏ</button>
</div>

</div>
</div>
</div>
`);
}
</script>

</div>
</section>
</main>

<!-- VIEWER -->
<div id="viewer3d" class="viewer3d hidden">
<div id="viewer3d-canvas"></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="script.js"></script>

</body>
</html>
