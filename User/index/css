/* =========================================
   19. TRANG QUẢN LÝ TÀI KHOẢN (ACCOUNT PAGE)
   ========================================= */
.account-page-wrapper { display: flex; max-width: 1200px; margin: 120px auto 60px; gap: 40px; padding: 0 30px; position: relative; z-index: 10; align-items: flex-start; }

/* Sidebar Tài Khoản */
.account-sidebar { width: 280px; flex-shrink: 0; background: rgba(25, 25, 25, 0.6); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 25px; padding: 30px 20px; box-shadow: 0 15px 35px rgba(0,0,0,0.3); }
.account-user-brief { display: flex; align-items: center; gap: 15px; margin-bottom: 25px; padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); }
.account-user-brief .avatar { width: 50px; height: 50px; background: linear-gradient(135deg, #ff9a9e, #fecfef); border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 24px; color: #1a1a1a; }
.account-user-brief .info p { margin: 0; line-height: 1.2; }
.account-user-brief .info p:first-child { font-size: 16px; font-weight: 600; color: #fff; }
.account-user-brief .info p:last-child { font-size: 13px; color: #aaa; }

.account-menu { list-style: none; padding: 0; margin: 0; }
.account-menu li { padding: 14px 20px; margin-bottom: 8px; border-radius: 15px; cursor: pointer; transition: 0.3s; color: #ccc; display: flex; align-items: center; gap: 12px; font-size: 15px; font-weight: 500; }
.account-menu li i { font-size: 20px; }
.account-menu li:hover, .account-menu li.active { background: rgba(255, 182, 193, 0.15); color: #ffb6c1; }

.back-home-btn { width: 100%; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: #fff; padding: 12px 15px; border-radius: 15px; font-size: 14px; font-family: 'Poppins', sans-serif; font-weight: 500; cursor: pointer; display: flex; align-items: center; gap: 10px; margin-bottom: 25px; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
.back-home-btn i { font-size: 18px; transition: transform 0.3s; }
.back-home-btn:hover { background: rgba(255, 182, 193, 0.1); color: #ffb6c1; border-color: #ffb6c1; box-shadow: 0 5px 15px rgba(255, 182, 193, 0.2); }
.back-home-btn:hover i { transform: translateX(-5px); }

/* Main Content Tài Khoản */
.account-main-content { flex: 1; background: rgba(25, 25, 25, 0.6); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 25px; padding: 40px; box-shadow: 0 15px 35px rgba(0,0,0,0.3); min-height: 500px; }
.account-section { display: none; animation: fadeIn 0.4s ease; }
.account-section.active { display: block; }
.account-header { border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 20px; margin-bottom: 30px; }
.account-header h2 { font-family: 'Playfair Display', serif; font-size: 28px; color: #ffb6c1; margin-bottom: 5px; }
.account-header p { color: #aaa; font-size: 14px; }

/* Form Hồ Sơ */
.profile-form { max-width: 600px; display: flex; flex-direction: column; gap: 20px; }
.form-group { display: flex; align-items: center; gap: 20px; }
.form-group label { width: 130px; color: #ccc; font-size: 14px; text-align: right; }
.form-group input[type="text"], .form-group input[type="email"], .form-group input[type="tel"], .form-group input[type="password"] { flex: 1; background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.2); color: #fff; padding: 14px 20px; border-radius: 12px; outline: none; transition: 0.3s; font-size: 14px; }
.form-group input:focus { border-color: #ffb6c1; box-shadow: 0 0 10px rgba(255,182,193,0.2); }
.radio-group { display: flex; gap: 20px; flex: 1; align-items: center; color: #fff; font-size: 14px; }
.radio-group input[type="radio"] { accent-color: #ffb6c1; width: 16px; height: 16px; cursor: pointer; }

/* Đơn Hàng (Orders) */
.order-tabs { display: flex; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 25px; overflow-x: auto; white-space: nowrap; }
.order-tabs::-webkit-scrollbar { height: 0; }
.order-tab { padding: 12px 20px; color: #aaa; cursor: pointer; transition: 0.3s; font-weight: 500; position: relative; }
.order-tab:hover { color: #ffb6c1; }
.order-tab.active { color: #ffb6c1; }
.order-tab.active::after { content: ''; position: absolute; bottom: -1px; left: 0; width: 100%; height: 2px; background: #ffb6c1; box-shadow: 0 0 10px #ffb6c1; }

.order-card { background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.08); border-radius: 15px; padding: 20px; margin-bottom: 20px; transition: 0.3s; }
.order-card:hover { border-color: rgba(255,182,193,0.3); box-shadow: 0 5px 15px rgba(0,0,0,0.2); }
.order-card-header { display: flex; justify-content: space-between; border-bottom: 1px dashed rgba(255,255,255,0.1); padding-bottom: 15px; margin-bottom: 15px; font-size: 14px; }
.order-status { color: #4cd137; font-weight: 600; display: flex; align-items: center; gap: 5px; }
.order-status.cancel { color: #ff4757; }
.order-item { display: flex; gap: 15px; align-items: center; }
.order-item img { width: 80px; height: 80px; border-radius: 10px; object-fit: cover; }
.order-item-info { flex: 1; }
.order-item-info h4 { color: #fff; font-size: 16px; margin-bottom: 5px; }
.order-item-info p { color: #aaa; font-size: 13px; margin-bottom: 3px; }
.order-item-price { color: #ffb6c1; font-weight: 600; font-size: 16px; }
.order-card-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed rgba(255,255,255,0.1); padding-top: 15px; margin-top: 15px; }
.order-total { font-size: 16px; color: #fff; }
.order-total strong { color: #ffb6c1; font-size: 22px; margin-left: 10px; }

/* Address Card */
.address-card { background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 15px; padding: 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; transition: 0.3s; }
.address-card:hover { border-color: rgba(255,182,193,0.3); }
.address-info h4 { color: #fff; font-size: 16px; margin-bottom: 5px; display: flex; align-items: center; gap: 10px; }
.address-badge { font-size: 10px; padding: 3px 8px; background: #ffb6c1; color: #1a1a1a; border-radius: 10px; font-weight: bold; }
.address-info p { color: #aaa; font-size: 14px; line-height: 1.5; margin-bottom: 3px; }
.address-actions button { background: transparent; border: none; color: #ffb6c1; cursor: pointer; font-size: 14px; margin-left: 15px; transition: 0.3s; }
.address-actions button:hover { text-decoration: underline; }

/* Responsive cho trang Account */
@media screen and (max-width: 900px) {
  .account-page-wrapper { flex-direction: column; gap: 20px; padding: 0 15px; margin-top: 100px; }
  .account-sidebar { width: 100%; padding: 20px; }
  .account-menu { display: flex; overflow-x: auto; gap: 10px; }
  .account-menu li { white-space: nowrap; margin-bottom: 0; }
  .account-menu::-webkit-scrollbar { height: 0; }
  .account-main-content { padding: 25px; }
  .form-group { flex-direction: column; align-items: flex-start; gap: 8px; }
  .form-group label { width: 100%; text-align: left; }
}

