/* =========================================
   1. RESET & GLOBAL STYLE
   ========================================= */
* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
html { scroll-behavior: smooth; }
body { background: #1a1a1a; overflow-x: hidden; color: white; }
body.no-scroll { overflow: hidden !important; }

/* =========================================
   2. KỸ XẢO NỀN: BLOBS MỜ & CANVAS 3D
   ========================================= */
.blob { position: fixed; border-radius: 50%; filter: blur(80px); z-index: -1; opacity: 0.5; animation: floatBlob 20s infinite alternate ease-in-out; pointer-events: none; }
.blob-1 { width: 400px; height: 400px; background: linear-gradient(135deg, #ff9a9e, #fecfef); top: -100px; left: -100px; }
.blob-2 { width: 500px; height: 500px; background: linear-gradient(135deg, #a18cd1, #fbc2eb); bottom: -200px; right: -100px; animation-delay: -5s; }
.blob-3 { width: 300px; height: 300px; background: linear-gradient(135deg, #ffb6c1, #ffc3a0); top: 40%; left: 50%; transform: translate(-50%, -50%); animation-delay: -10s; opacity: 0.3; }

@keyframes floatBlob {
  0% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(50px, 50px) scale(1.1); }
  100% { transform: translate(-50px, -30px) scale(0.9); }
}

canvas { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 0; pointer-events: none; }

.petal { position: fixed; pointer-events: none; z-index: 999999; animation: fallingPetal 1.5s forwards ease-out; font-size: 20px; }
@keyframes fallingPetal {
  0% { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 1; }
  100% { transform: translate(var(--tx), var(--ty)) rotate(var(--rot)) scale(0.5); opacity: 0; }
}

/* =========================================
   3. DROPDOWN TÀI KHOẢN
   ========================================= */
.user-dropdown-wrapper { position: relative; display: inline-block; padding: 10px 0; }
.user-dropdown-wrapper:hover .user-dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
.user-dropdown.mobile-show { opacity: 1; visibility: visible; transform: translateY(0); } 
.user-dropdown { position: absolute; top: 100%; right: -20px; width: 280px; background: rgba(25, 25, 25, 0.95); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); border: 1px solid rgba(255, 182, 193, 0.3); border-radius: 18px; padding: 0; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6); opacity: 0; visibility: hidden; transform: translateY(15px); transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); z-index: 10000; overflow: hidden; }
.user-dropdown::before { content: ""; position: absolute; top: -7px; right: 45px; width: 14px; height: 14px; background: rgba(25, 25, 25, 0.95); border-left: 1px solid rgba(255, 182, 193, 0.3); border-top: 1px solid rgba(255, 182, 193, 0.3); transform: rotate(45deg); z-index: -1; }
.dropdown-header { display: flex; align-items: center; gap: 15px; padding: 20px; background: linear-gradient(135deg, rgba(255, 182, 193, 0.15), rgba(0,0,0,0)); border-bottom: 1px solid rgba(255,255,255,0.05); }
.dropdown-avatar { width: 45px; height: 45px; background: #ffb6c1; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 5px 15px rgba(255,182,193,0.4); color: #1a1a1a; }
.dropdown-avatar i { font-size: 24px; color: #1a1a1a; }
.dropdown-user-info p { margin: 0; line-height: 1.2; }
.dropdown-greeting { font-size: 12px; color: #aaa; }
.dropdown-name { font-size: 16px; font-weight: 600; color: #ffb6c1; margin-top: 4px !important; }
.dropdown-menu-list { display: flex !important; flex-direction: column !important; list-style: none !important; padding: 10px 0; margin: 0; width: 100%; }
.dropdown-menu-list li { padding: 12px 20px; font-size: 14px; color: #ddd; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 12px; }
.dropdown-menu-list li:hover { background: rgba(255, 182, 193, 0.1); color: #fff; padding-left: 25px; }
.dropdown-menu-list li:hover .li-icon { transform: scale(1.2); color: #ffb6c1; }
.li-icon { transition: 0.3s; display: flex; align-items: center; justify-content: center; }
.li-icon i { font-size: 18px; }
.dropdown-divider { border: 0; height: 1px; background: rgba(255, 255, 255, 0.08); margin: 5px 20px; }
#logout-action { color: #ff6b81; font-weight: 500; }
#logout-action:hover { background: rgba(255, 107, 129, 0.1); color: #ff6b81; }

/* =========================================
   4. HERO SECTION
   ========================================= */
.hero { height: 100vh; display: flex; align-items: center; justify-content: center; position: relative; color: white; text-align: center; z-index: 10; pointer-events: none; perspective: 1000px; }
.hero-content { position: relative; z-index: 20; transition: transform 0.1s ease-out; transform-style: preserve-3d; pointer-events: auto; }
.hero h2.hero-title { font-family: 'Playfair Display', serif; font-size: 80px; line-height: 1.2; background: linear-gradient(to right, #ffb6c1, #fecfef, #a1c4fd, #ffb6c1); background-size: 300% auto; color: transparent; -webkit-background-clip: text; background-clip: text; animation: shineText 15s linear infinite; }
@keyframes shineText { to { background-position: 300% center; } }
.hero .subtitle { font-size: 50px; font-weight: 400; display: block; color: white; -webkit-text-fill-color: initial; }
.explore-wrapper { margin-top: 50px; display: flex; flex-direction: column; align-items: center; gap: 10px; position: relative; z-index: 1000; transform: translateZ(50px); }
.explore-btn { padding: 14px 45px; border-radius: 40px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); color: white; font-family: 'Poppins', sans-serif; font-weight: 500; letter-spacing: 2px; cursor: pointer; transition: 0.4s; pointer-events: auto; display: inline-block; }
.explore-btn:hover { transform: translateY(-6px); box-shadow: 0 15px 40px rgba(255, 182, 193, 0.3); background: rgba(255, 255, 255, 0.2); }
.arrow { font-size: 26px; animation: float 2s infinite ease-in-out; }
@keyframes float { 0% { transform: translateY(0); } 50% { transform: translateY(12px); } 100% { transform: translateY(0); } }

/* =========================================
   5. BỐ CỤC CHUNG & CARDS
   ========================================= */
.section-container { padding: 120px 80px 40px; position: relative; z-index: 10; pointer-events: auto; }
.section-header { text-align: center; margin-bottom: 60px; color: white; }
.section-header h2 { font-family: 'Playfair Display', serif; font-size: 45px; color: #ffb6c1; margin-bottom: 10px; letter-spacing: 2px; }
.section-header p { color: #ccc; font-size: 16px; letter-spacing: 1px; }
.fade-in { opacity: 0; filter: blur(5px); transform: translateY(50px); transition: all 0.8s cubic-bezier(0.165, 0.84, 0.44, 1); will-change: transform, opacity; }
.fade-in.show { opacity: 1; filter: blur(0px); transform: translateY(0); }
.cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); justify-content: center; gap: 50px; }

.card { max-width: 380px; margin: 0 auto; width: 100%; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 25px; padding: 20px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3); display: flex; flex-direction: column; gap: 15px; text-align: left; opacity: 0; transform: translateY(80px) scale(0.85); transition: opacity 0.8s, transform 0.8s, box-shadow 0.3s, border-color 0.3s; cursor: pointer; color: white; will-change: transform, opacity; }
.card.show { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
.card:hover { box-shadow: 0 20px 50px rgba(255, 182, 193, 0.25); border-color: rgba(255, 182, 193, 0.5); }
.img-wrapper { border-radius: 15px; overflow: hidden; position: relative; width: 100%; }
.card-img { width: 100%; height: 220px; object-fit: cover; transition: transform 0.6s; display: block; }
.card:hover .card-img { transform: scale(1.1); }
.card-badge { position: absolute; top: 15px; left: 15px; background: linear-gradient(45deg, #ff9a9e 0%, #fecfef 100%); color: #1a1a1a; padding: 6px 14px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; z-index: 2; box-shadow: 0 5px 15px rgba(0,0,0,0.3); }
.card-info { display: flex; flex-direction: column; flex: 1; padding: 0 5px; }
.card h3 { font-family: 'Playfair Display', serif; font-size: 24px; color: #fff; margin-bottom: 5px; transition: color 0.3s; }
.card:hover h3 { color: #ffb6c1; }
.card-subtitle { color: #aaa; font-size: 14px; margin-bottom: 20px; }
.card-bottom { margin-top: auto; display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed rgba(255, 255, 255, 0.15); padding-top: 15px; }
.card-price { font-size: 22px; font-weight: 600; color: #ffb6c1; }
.card-view-detail { font-size: 13px; color: #aaa; transition: 0.3s; display: flex; align-items: center; gap: 5px; }
.card:hover .card-view-detail { color: #fff; }
.card-view-detail span { color: #ffb6c1; transition: 0.3s; }
.card:hover .card-view-detail span { transform: translateX(5px); }

/* =========================================
   6. PROMO BANNER CAROUSEL
   ========================================= */
.banner-carousel { position: relative; width: 100%; }
.banner-slide { display: none; animation: fadeSlide 0.8s cubic-bezier(0.165, 0.84, 0.44, 1); will-change: transform, opacity; }
.banner-slide.active { display: block; }
@keyframes fadeSlide { from { opacity: 0; transform: scale(0.98) translateX(20px); } to { opacity: 1; transform: scale(1) translateX(0); } }

.banner-arrow { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(30, 30, 30, 0.5); backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px); color: white; width: 45px; height: 45px; border-radius: 50%; font-size: 20px; cursor: pointer; z-index: 20; transition: 0.3s; display: flex; align-items: center; justify-content: center; box-shadow: 0 5px 15px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); }
.banner-arrow:hover { background: #ffb6c1; color: #1a1a1a; transform: translateY(-50%) scale(1.1); }
.prev-arrow { left: -20px; }
.next-arrow { right: -20px; }

.premium-glass { background: linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02)); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid rgba(255, 182, 193, 0.3); border-radius: 30px; box-shadow: 0 30px 60px rgba(0,0,0,0.5); display: flex; overflow: hidden; align-items: stretch; min-height: 350px; }
.banner-image { 
    flex: 1; 
    position: relative; 
    overflow: hidden; 
    min-width: 45%; 
}

.banner-bg { 
    position: absolute; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    object-fit: cover; 
    object-position: center center; /* CHỐT NÀY ÉP ẢNH LUÔN NẰM NGAY CHÍNH GIỮA, KHÔNG BỊ LỆCH LÊN TRÊN */
    display: block; 
    transition: 0.8s; 
}
.banner-wrapper:hover .banner-bg { transform: scale(1.08) rotate(1deg); }
.discount-tag { position: absolute; top: 25px; left: 25px; background: #ff4757; color: white; padding: 12px 18px; border-radius: 15px; text-align: center; box-shadow: 0 10px 20px rgba(255,71,87,0.4); z-index: 5; animation: pulseTag 2s infinite; }
@keyframes pulseTag { 0% { transform: scale(1); } 50% { transform: scale(1.08); } 100% { transform: scale(1); } }
.tag-text { display: block; font-size: 24px; font-weight: 800; line-height: 1; }
.tag-label { font-size: 12px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; }

.banner-content { flex: 1.2; padding: 30px 40px; display: flex; flex-direction: column; justify-content: center; background: rgba(0,0,0,0.2); }
.flash-sale-header { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.flash-icon i { font-size: 24px; color: #ffb6c1; animation: flashIcon 1s infinite alternate; }
@keyframes flashIcon { from { text-shadow: 0 0 10px #ffb6c1; transform: scale(1); } to { text-shadow: 0 0 30px #ffb6c1; transform: scale(1.2); } }
.countdown-timer { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; font-weight: bold; color: #ffb6c1; font-size: 20px; }
.time-box { background: rgba(255,182,193,0.1); border: 1px solid rgba(255,182,193,0.2); padding: 8px 12px; border-radius: 12px; text-align: center; display: flex; flex-direction: column; min-width: 60px; }
.time-box span { font-size: 20px; color: #fff; line-height: 1; margin-bottom: 4px; }
.time-box small { font-size: 11px; color: #aaa; text-transform: uppercase; }
.promo-title { font-family: 'Playfair Display', serif; font-size: 32px; color: #fff; margin-bottom: 12px; line-height: 1.2; text-shadow: 0 5px 15px rgba(0,0,0,0.5); }
.price-block { margin-bottom: 20px; display: flex; align-items: flex-end; gap: 15px; }
.sale-price { font-size: 30px; font-weight: 700; color: #ffb6c1; line-height: 1; text-shadow: 0 0 20px rgba(255, 182, 193, 0.4); }
.original-price { font-size: 16px; color: #888; text-decoration: line-through; margin-bottom: 4px; }
.promo-perks { list-style: none; margin-bottom: 25px; }
.promo-perks li { margin-bottom: 10px; font-size: 14px; color: #ddd; display: flex; align-items: center; gap: 10px; }
.perk-icon i { font-size: 18px; color: #ffb6c1; }

.btn-san-deal { padding: 14px 40px; border-radius: 40px; background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%); color: #1a1a1a; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 15px; border: none; cursor: pointer; align-self: flex-start; transition: 0.3s; box-shadow: 0 10px 25px rgba(255, 182, 193, 0.4); display: flex; align-items: center; gap: 12px; }
.btn-san-deal:hover { transform: translateY(-6px) scale(1.02); box-shadow: 0 15px 35px rgba(255, 182, 193, 0.6); }
.btn-san-deal .arrow-icon { transition: 0.3s; font-size: 18px; }
.btn-san-deal:hover .arrow-icon { transform: translateX(6px); }

.banner-dots { text-align: center; margin-top: 25px; display: flex; justify-content: center; gap: 12px; }
.banner-dots .dot { height: 12px; width: 12px; background-color: rgba(255, 255, 255, 0.2); border-radius: 50%; display: inline-block; cursor: pointer; transition: 0.4s; }
.banner-dots .dot.active, .banner-dots .dot:hover { background-color: #ffb6c1; box-shadow: 0 0 10px rgba(255, 182, 193, 0.8); transform: scale(1.3); }
/* =========================================
   7. TESTIMONIAL MARQUEE
   ========================================= */
.testimonial-section { padding: 40px 0; overflow: hidden; position: relative; z-index: 10; pointer-events: none; }
.marquee-container { display: flex; width: max-content; animation: marqueeScroll 25s linear infinite; pointer-events: auto; }
.marquee-container:hover { animation-play-state: paused; }
.marquee-content { display: flex; gap: 30px; padding-right: 30px; }
.glass-pill { flex-shrink: 0; background: rgba(255,255,255,0.05); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid rgba(255,182,193,0.3); padding: 15px 30px; border-radius: 50px; color: #fff; font-size: 15px; white-space: nowrap; box-shadow: 0 10px 30px rgba(0,0,0,0.2); transition: 0.3s; cursor: default; }
.glass-pill:hover { border-color: #ffb6c1; transform: translateY(-5px); }
@keyframes marqueeScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

/* =========================================
   8. DỊCH VỤ
   ========================================= */
.service-features { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 20px; padding: 40px 20px; text-align: center; margin-bottom: 20px; }
.feature-item { display: flex; flex-direction: column; align-items: center; gap: 8px; }
.feature-icon i { font-size: 36px; color: #fff; margin-bottom: 10px; filter: drop-shadow(0 0 10px rgba(255, 182, 193, 0.4)); transition: transform 0.3s ease; }
.feature-item:hover .feature-icon i { transform: translateY(-5px) scale(1.1); color: #ffb6c1; }
.feature-item h4 { color: #ffb6c1; font-weight: 600; margin-bottom: 2px; }
.feature-item p { color: #ccc; font-size: 13px; }

/* =========================================
   9. MODAL CHUNG & CHI TIẾT SẢN PHẨM
   ========================================= */
.modal { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 10000; visibility: hidden; pointer-events: none; padding: 20px; transition: visibility 0.6s; }
.modal.active { visibility: visible; pointer-events: auto; }
.modal-overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0); z-index: 1; transition: background 0.5s ease; }
.modal.active .modal-overlay { background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
.modal-content { position: relative; z-index: 2; width: 100%; max-width: 850px; max-height: 85vh; overflow-y: auto; background: rgba(40, 40, 40, 0.85); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 25px; padding: 40px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5); color: white; opacity: 0; transform: translateY(80px) scale(0.8); transition: transform 0.6s, opacity 0.4s; }
.modal.active .modal-content { opacity: 1; transform: translateY(0) scale(1); }
.close-btn { position: absolute; top: 20px; right: 25px; font-size: 28px; color: #aaa; cursor: pointer; transition: 0.3s; line-height: 1; z-index: 10; }
.close-btn:hover { color: #ffb6c1; transform: rotate(90deg) scale(1.2); }

.modal-body { display: flex; gap: 40px; flex-wrap: wrap; width: 100%; }
.modal-gallery { flex: 1; min-width: 280px; display: flex; flex-direction: column; gap: 15px; }
.modal-img-container { position: relative !important; width: 100%; height: 350px !important; border-radius: 15px; overflow: hidden; background-color: #2c2c2c; }
.modal-main-img { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-position: center; background-size: contain; background-repeat: no-repeat; transition: opacity 0.2s ease-in-out; }
.gallery-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(30, 30, 30, 0.7); color: white; border: none; width: 40px; height: 40px; border-radius: 50%; font-size: 18px; cursor: pointer; z-index: 10; transition: 0.3s; display: flex; align-items: center; justify-content: center; }
.gallery-btn:hover { background: #ffb6c1; color: #1a1a1a; transform: translateY(-50%) scale(1.1); }
.prev-btn { left: 10px; } .next-btn { right: 10px; } 

.modal-thumbnails { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 5px; }
.thumb-img { width: 70px; height: 70px; flex-shrink: 0; border-radius: 10px; background-position: center; background-size: cover; cursor: pointer; border: 2px solid transparent; transition: 0.3s; opacity: 0.6; }
.thumb-img.active, .thumb-img:hover { border-color: #ffb6c1; opacity: 1; }

.modal-info { flex: 1; min-width: 280px; display: flex; flex-direction: column; justify-content: center; max-height: 450px; }
.modal-info h2 { font-family: 'Playfair Display', serif; font-size: 36px; color: #ffb6c1; margin-bottom: 15px; }
.modal-info .price { font-size: 26px; font-weight: 600; color: #fff; margin-bottom: 20px; }
.modal-info p#modal-desc { overflow-y: auto; padding-right: 10px; flex: 1; color: #ccc; font-size: 14px; line-height: 1.6; margin-bottom: 20px; }
#modal-desc::-webkit-scrollbar { width: 5px; }
#modal-desc::-webkit-scrollbar-track { background: rgba(0,0,0,0.1); border-radius: 10px; }
#modal-desc::-webkit-scrollbar-thumb { background: rgba(255,182,193,0.5); border-radius: 10px; }

.add-to-cart { padding: 14px 35px; border-radius: 40px; background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%); color: #1a1a1a; font-weight: 600; border: none; cursor: pointer; align-self: flex-start; transition: 0.3s; font-size: 15px; display: flex; align-items: center; gap: 8px;}
.add-to-cart:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(255, 182, 193, 0.5); }
.add-to-cart i { font-size: 20px; }

/* =========================================
   10. AUTH MODAL
   ========================================= */
/* =========================================
   FORM ĐĂNG KÝ / ĐĂNG NHẬP MỚI (ĐÃ FIX LỖI)
   ========================================= */
.modal { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 10000; visibility: hidden; padding: 20px; transition: visibility 0.4s; }
.modal.active { visibility: visible; }
.modal-overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0); transition: 0.4s; }
.modal.active .modal-overlay { background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(10px); }
.modal-content { position: relative; width: 100%; max-width: 480px; background: rgba(30, 30, 30, 0.95); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 25px; padding: 40px; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5); color: white; opacity: 0; transform: translateY(50px); transition: 0.4s; overflow-x: hidden; /* Chống tràn thanh cuộn ngang */ }
.modal.active .modal-content { opacity: 1; transform: translateY(0); }
.close-btn { position: absolute; top: 15px; right: 20px; font-size: 28px; color: #aaa; cursor: pointer; z-index: 20; transition: 0.3s; }
.close-btn:hover { color: #ffb6c1; transform: rotate(90deg); }

.auth-tabs { display: flex; justify-content: center; gap: 30px; margin-bottom: 25px; border-bottom: 1px solid rgba(255,255,255,0.1); }
.tab-btn { background: none; border: none; font-size: 20px; font-family: 'Playfair Display', serif; padding-bottom: 12px; cursor: pointer; color: #777; position: relative; }
.tab-btn.active { color: #ffb6c1; }
.tab-btn.active::after { content: ''; position: absolute; bottom: -1px; left: 0; width: 100%; height: 2px; background: #ffb6c1; box-shadow: 0 0 10px #ffb6c1; }

.auth-form { display: none; flex-direction: column; gap: 15px; width: 100%; } 
.auth-form.active { display: flex; animation: fadeIn 0.4s; }

/* FIX: Đưa Group về block để không làm méo input */
.input-group { position: relative; width: 100%; display: block; }

/* FIX: Canh giữa icon theo chiều dọc */
.modern-form .input-icon { 
  position: absolute; 
  left: 15px; 
  top: 50%; 
  transform: translateY(-50%); 
  font-size: 20px; 
  color: #aaa; 
  z-index: 10; 
  pointer-events: none; 
}

/* FIX: Kích thước Input */
