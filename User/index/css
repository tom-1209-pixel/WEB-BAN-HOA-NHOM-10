:root{
--font-heading:'Playfair Display',serif;
--font-body:'Inter',sans-serif;
}

body{
margin:0;
overflow-x:hidden;
color:white;
font-family:var(--font-body);
background:radial-gradient(circle at top,#1a0f1f,#0a0710 60%,#050308);
}

/* 3D BG */
#canvas-container{
position:fixed;
inset:0;
z-index:0;
pointer-events:none;
}

.navbar,main{
position:relative;
z-index:2;
}

/* NAVBAR */
.navbar{
height:80px;
background:rgba(0,0,0,.7)!important;
backdrop-filter:blur(8px);
transition:all .35s ease;
}

.navbar.scrolled{
height:60px;
background:rgba(0,0,0,.35)!important;
backdrop-filter:blur(18px);
box-shadow:0 6px 25px rgba(0,0,0,.35);
opacity:.85;
}

.navbar-brand{
font-family:var(--font-heading);
letter-spacing:1px;
transition:.35s;
}

.navbar.scrolled .navbar-brand{
transform:scale(.9);
text-shadow:
0 0 8px rgba(255,182,193,.6),
0 0 18px rgba(255,105,180,.4);
}

main{padding-top:90px;}

.hero-section{
height:100vh;
display:flex;
align-items:center;
justify-content:flex-start;
}

.hero-section h1{
font-family:var(--font-heading);
font-size:clamp(3rem,6vw,5rem);
}

/* BUTTON */
.btn-primary{
background:linear-gradient(135deg,#ff9ecb,#ff69b4);
border:none;
box-shadow:0 0 20px rgba(255,105,180,.4);
transition:.3s;
}

.btn-primary:hover{
transform:translateY(-2px);
box-shadow:0 8px 25px rgba(255,105,180,.6);
}

/* GLASS */
.glass-card{
background:rgba(255,255,255,.08);
backdrop-filter:blur(14px);
border-radius:16px;
border:1px solid rgba(255,182,193,.25);
transition:.35s;
}

.glass-card:hover{
transform:translateY(-10px);
box-shadow:
0 10px 30px rgba(255,182,193,.25),
0 0 40px rgba(255,105,180,.15);
}

.price{
color:#ffb6c1;
font-weight:bold;
}

/* VIEWER */
.viewer3d{
position:fixed;
inset:0;
background:rgba(0,0,0,.85);
backdrop-filter:blur(10px);
display:flex;
justify-content:center;
align-items:center;
z-index:9999;
transition:.4s;
}

.viewer3d.hidden{
opacity:0;
pointer-events:none;
}

#viewer3d-canvas{
width:60vw;
height:60vh;
}
/* cinematic smooth */
html{
scroll-behavior:smooth;
}

/* GPU smooth animation */
.glass-card{
transition:transform .25s ease, box-shadow .3s;
will-change:transform;
}

/* navbar glow */
.navbar{
transition:.35s ease;
}
