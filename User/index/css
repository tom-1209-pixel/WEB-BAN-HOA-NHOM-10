/* =========================================
   1. RESET & CÀI ĐẶT CHUNG
   ========================================= */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Poppins', sans-serif;
}

html { scroll-behavior: smooth; }

body {
  background: linear-gradient(135deg, #1a1a1a, #2c2c2c);
  overflow-x: hidden;
  color: white;
}

body.no-scroll { overflow: hidden !important; }

/* =========================================
   2. CANVAS 3D BACKGROUND
   ========================================= */
canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: auto;
}

/* =========================================
   3. NAVBAR (Glassmorphism)
   ========================================= */
nav {
  position: fixed;
  top: 0;
  width: 100%;
  padding: 20px 60px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(25, 25, 25, 0.4);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  z-index: 9999; 
  transition: 0.4s ease;
}

nav.scrolled {
  background: rgba(25, 25, 25, 0.85);
  box-shadow: 0 5px 30px rgba(0, 0, 0, 0.5);
}

nav h1 {
  font-family: 'Playfair Display', serif;
  font-size: 28px;
  letter-spacing: 2px;
  color: #ffb6c1;
}

nav ul {
  display: flex;
  gap: 30px;
  list-style: none;
}

nav ul li a {
  text-decoration: none;
  color: #f0f0f0;
  font-weight: 500;
  transition: color 0.3s;
}

nav ul li a:hover { color: #ffb6c1; }

.nav-actions {
  display: flex;
  gap: 20px;
  align-items: center;
}

.nav-btn {
  cursor: pointer;
  font-weight: 500;
  color: #f0f0f0;
  transition: 0.3s;
}

.nav-btn:hover { color: #ffb6c1; }

#cart-count {
  background: #ffb6c1;
  color: #1a1a1a;
  padding: 2px 8px;
  border-radius: 20px;
  font-size: 12px;
  margin-left: 5px;
  font-weight: 700;
}

/* =========================================
   4. HERO SECTION
   ========================================= */
.hero {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  color: white;
  text-align: center;
  z-index: 10;
  pointer-events: none;
  perspective: 1000px;
}

.hero-content {
  position: relative;
  z-index: 20;
  transition: transform 0.1s ease-out;
  transform-style: preserve-3d;
  pointer-events: auto;
}

.hero h2.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: 70px;
  line-height: 1.2;
}

.hero .subtitle {
  font-size: 50px;
  font-weight: 400;
  display: block;
}

.explore-wrapper {
  margin-top: 50px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  position: relative;
  z-index: 1000;
  transform: translateZ(50px);
}

.explore-btn {
  padding: 14px 45px;
  border-radius: 40px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  color: white;
  font-family: 'Poppins', sans-serif;
  font-weight: 500;
  letter-spacing: 2px;
  cursor: pointer;
  transition: 0.4s;
  pointer-events: auto;
  display: inline-block;
}

.explore-btn:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 40px rgba(255, 182, 193, 0.3);
  background: rgba(255, 255, 255, 0.2);
}

.arrow {
  font-size: 26px;
  animation: float 2s infinite ease-in-out;
}

@keyframes float {
  0% { transform: translateY(0); }
  50% { transform: translateY(12px); }
  100% { transform: translateY(0); }
}

/* =========================================
   5. BỐ CỤC CHUNG & ANIMATION FADE-IN
   ========================================= */
.section-container {
  padding: 120px 80px 40px;
  position: relative;
  z-index: 10;
  pointer-events: auto;
}

.section-header {
  text-align: center;
  margin-bottom: 60px;
  color: white;
}

.section-header h2 {
  font-family: 'Playfair Display', serif;
  font-size: 45px;
  color: #ffb6c1;
  margin-bottom: 10px;
  letter-spacing: 2px;
}

.section-header p {
  color: #ccc;
  font-size: 16px;
  letter-spacing: 1px;
}

.section-header.fade-in,
.category-group.fade-in {
  opacity: 0;
  filter: blur(10px);
  transform: translateY(50px);
  transition: all 0.8s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.section-header.fade-in.show,
.category-group.fade-in.show {
  opacity: 1;
  filter: blur(0px);
  transform: translateY(0);
}

.cards-grid {
  display: grid;
  /* Đã fix lỗi thẻ bị kéo giãn khổng lồ bằng auto-fill */
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 50px;
}

.category-group {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 30px;
  padding: 50px;
  margin-bottom: 60px;
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
}

.category-title {
  font-family: 'Playfair Display', serif;
  font-size: 32px;
  color: #fecfef;
  margin-bottom: 40px;
  border-left: 5px solid #ffb6c1;
  padding-left: 20px;
  text-transform: uppercase;
  letter-spacing: 2px;
}

/* =========================================
   6. CARDS (Redesign Giao Diện ẢNH Đẹp & Fix lỗi)
   ========================================= */
.card {
  /* Chốt chặn an toàn: thẻ không bao giờ to hơn 380px và luôn căn giữa nếu đứng 1 mình */
  max-width: 380px;
  margin: 0 auto;
  width: 100%;

  background: rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 25px;
  padding: 20px; 
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
  
  display: flex;
  flex-direction: column;
  gap: 15px;
  text-align: left; 

  opacity: 0;
  filter: blur(10px);
  transform: translateY(80px) scale(0.85);
  pointer-events: none;
  
  transition: opacity 0.8s cubic-bezier(0.165, 0.84, 0.44, 1),
              transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1),
              filter 0.8s cubic-bezier(0.165, 0.84, 0.44, 1),
              box-shadow 0.3s ease, border-color 0.3s ease;
  transform-style: preserve-3d;
  cursor: pointer;
  color: white;
}

.card.show {
  opacity: 1;
  filter: blur(0px);
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.card:hover { 
  box-shadow: 0 20px 50px rgba(255, 182, 193, 0.25); 
  border-color: rgba(255, 182, 193, 0.5);
}

.img-wrapper {
  border-radius: 15px;
  overflow: hidden;
  position: relative;
  width: 100%;
}

.card-img {
  width: 100%;
  height: 220px; 
  background-position: center;
  background-size: cover;
  transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.card:hover .card-img {
  transform: scale(1.1); 
}

.card-badge {
  position: absolute;
  top: 15px;
  left: 15px;
  background: linear-gradient(45deg, #ff9a9e 0%, #fecfef 100%);
  color: #1a1a1a;
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  z-index: 2;
  box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}

.card-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 0 5px;
}

.card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  color: #fff;
  margin-bottom: 5px;
  transition: color 0.3s;
}

.card:hover h3 {
  color: #ffb6c1; 
}

.card-subtitle {
  color: #aaa;
  font-size: 14px;
  margin-bottom: 20px;
}

.card-bottom {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px dashed rgba(255, 255, 255, 0.15);
  padding-top: 15px;
}

.card-price {
  font-size: 22px;
  font-weight: 600;
  color: #ffb6c1;
}

.card-icon {
  width: 35px;
  height: 35px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 300;
  transition: 0.3s;
}

.card:hover .card-icon {
  background: #ffb6c1;
  color: #1a1a1a;
  transform: rotate(90deg);
}

/* =========================================
   7. FOOTER
   ========================================= */
footer {
  padding: 40px;
  text-align: center;
  background: rgba(25, 25, 25, 0.5);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  position: relative;
  z-index: 10;
  color: #aaa;
  pointer-events: auto;
}

/* =========================================
   8. COMMON MODAL
   ========================================= */
.modal {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center; 
  justify-content: center;
  z-index: 10000;
  visibility: hidden; 
  pointer-events: none;
  padding: 20px;
  transition: visibility 0.6s;
}

.modal.active {
  visibility: visible;
  pointer-events: auto;
}

.modal-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0); 
  backdrop-filter: blur(0px); 
  -webkit-backdrop-filter: blur(0px);
  z-index: 1;
  transition: background 0.5s ease, backdrop-filter 0.5s ease, -webkit-backdrop-filter 0.5s ease;
}

.modal.active .modal-overlay {
  background: rgba(0, 0, 0, 0.7); 
  backdrop-filter: blur(15px); 
  -webkit-backdrop-filter: blur(15px);
}

.modal-content {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 850px;
  max-height: 85vh; 
  overflow-y: auto; 
  background: rgba(40, 40, 40, 0.85);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 25px;
  padding: 40px;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5);
  color: white;
  
  opacity: 0;
  transform: translateY(80px) scale(0.8);
  transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease-out; 
}

.modal.active .modal-content { 
  opacity: 1;
  transform: translateY(0) scale(1); 
}

.close-btn {
  position: absolute;
  top: 20px;
  right: 25px;
  font-size: 32px;
  color: #aaa;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  line-height: 1;
  z-index: 10;
}

.close-btn:hover {
  color: #ffb6c1;
  transform: rotate(90deg) scale(1.2); 
}

/* =========================================
   9. CHI TIẾT MODAL SẢN PHẨM
   ========================================= */
.modal-body {
  display: flex;
  gap: 40px;
  flex-wrap: wrap;
}

.modal-img {
  flex: 1;
  min-width: 280px;
  height: 350px;
  background: url('https://images.unsplash.com/photo-1563241527-3004b7be0ffd') center/cover no-repeat;
  border-radius: 15px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.modal-info {
  flex: 1;
  min-width: 280px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.modal-info h2 {
  font-family: 'Playfair Display', serif;
  font-size: 36px;
  color: #ffb6c1;
  margin-bottom: 15px;
}

.modal-info p {
  color: #ccc;
  line-height: 1.6;
  font-size: 15px;
  margin-bottom: 20px;
}

.modal-info .price {
  font-size: 26px;
  font-weight: 600;
  color: #fff;
  margin-bottom: 30px;
}

.add-to-cart {
  padding: 14px 35px;
  border: none;
  border-radius: 40px;
  background: #ffb6c1;
  color: #1a1a1a;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.3s;
  align-self: flex-start;
  box-shadow: 0 5px 15px rgba(255, 182, 193, 0.3);
}

.add-to-cart:hover {
  background: #ff69b4;
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(255, 182, 193, 0.5);
}

/* =========================================
   10. AUTH MODAL
   ========================================= */
.auth-content {
  max-width: 400px;
  text-align: center;
}

.auth-tabs {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-bottom: 30px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.tab-btn {
  background: none;
  border: none;
  font-size: 18px;
  font-family: 'Playfair Display', serif;
  padding-bottom: 10px;
  cursor: pointer;
  color: #aaa;
}

.tab-btn.active {
  color: #ffb6c1;
  border-bottom: 2px solid #ffb6c1;
}

.auth-form {
  display: none;
  flex-direction: column;
  gap: 15px;
}

.auth-form.active { display: flex; }

.auth-form input {
  padding: 15px;
  border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.2);
  background: rgba(0,0,0,0.2);
  font-family: 'Poppins', sans-serif;
  color: white;
  outline: none;
}

.submit-btn {
  padding: 15px;
  border: none;
  border-radius: 10px;
  background: #ffb6c1;
  color: #1a1a1a;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.3s;
}

.submit-btn:hover { background: #ff69b4; }

/* =========================================
   11. CART SIDEBAR
   ========================================= */
.cart-sidebar {
  position: fixed;
  top: 0;
  right: 0; 
  width: 100%;
  max-width: 450px;
  height: 100vh;
  background: rgba(30, 30, 30, 0.9);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  box-shadow: -20px 0 50px rgba(0,0,0,0.5); 
  z-index: 10000;
  display: flex;
  flex-direction: column;
  color: white;
  
  transform: translateX(100%);
  transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.cart-sidebar.open { transform: translateX(0); }

.cart-header {
  padding: 30px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-header h2 { font-family: 'Playfair Display', serif; color: #ffb6c1;}

.close-cart {
  font-size: 30px;
  cursor: pointer;
  color: #aaa;
  transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.3s;
}

.close-cart:hover { 
  color: #ffb6c1; 
  transform: rotate(90deg) scale(1.1); 
}

.cart-items {
  flex: 1;
  padding: 30px;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding-bottom: 10px;
  border-bottom: 1px dashed rgba(255,255,255,0.1);
}

.cart-footer {
  padding: 30px;
  border-top: 1px solid rgba(255,255,255,0.1);
  background: rgba(0,0,0,0.2);
}

.cart-total {
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 20px;
  display: flex;
  justify-content: space-between;
}

.checkout-btn {
  width: 100%;
  padding: 15px;
  background: #ffb6c1;
  color: #1a1a1a;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: 0.3s;
}

.checkout-btn:hover { 
  background: #ff69b4; 
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(255, 182, 193, 0.4);
}

/* =========================================
   12. SỐ LƯỢNG (QUANTITY CONTROLS)
   ========================================= */
.quantity-control {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 25px;
}

.qty-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: white;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  font-size: 18px;
  cursor: pointer;
  transition: all 0.3s;
  display: flex;
  justify-content: center;
  align-items: center;
}

.qty-btn:hover {
  background: #ffb6c1;
  color: #1a1a1a;
  transform: scale(1.1);
}

.qty-display {
  font-size: 18px;
  font-weight: 600;
  min-width: 25px;
  text-align: center;
}

.cart-item-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
}

.cart-item-controls .qty-btn {
  width: 25px;
  height: 25px;
  font-size: 14px;
}

.cart-item-controls .qty-display {
  font-size: 14px;
}

/* =========================================
   13. SCROLLBAR CUSTOMIZATION
   ========================================= */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(255, 182, 193, 0.4); border-radius: 10px; }
::-webkit-scrollbar-thumb:hover { background: rgba(255, 182, 193, 0.8); }
